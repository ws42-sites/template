{
  "name": "ws42-template",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --port 4321",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "check": "astro check",
    "cms": "npx decap-server",
    "check:arch": "node scripts/check-architecture.mjs",
    "rollback": "node scripts/pages-rollback.mjs --project ws42-template",
    "smoke": "guardrails smoke --url https://ws42-template.pages.dev / /privacy/ /robots.txt /sitemap.xml /admin/",
    "secrets:check": "guardrails secrets-check --require GITHUB_CLIENT_ID,GITHUB_CLIENT_SECRET -- wrangler pages secret list --project-name ws42-template",
    "check:guardrails": "guardrails check --only docs,runbook,ci"
  },
  "dependencies": {
    "@sentry/astro": "^11.12.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "marked": "^18.2.0",
    "sanitize-html": "^2.18.2",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "2.6.7",
    "@types/sanitize-html": "^2.16.2",
    "@ws42/guardrails": "file:vendor/ws42-guardrails-0.4.2.tgz",
    "decap-server": "^3.11.6",
    "typescript": "~6.0.3",
    "wrangler": "^4.162.0"
  }
}
