---
import { getCollection } from "astro:content";
import Analytics from "../components/Analytics.astro";
import { isReservedPageSlug } from "../lib/page-slugs";
import { getSiteUrl, getSupportUrl, siteConfig } from "../site.config";
import "../styles/global.css";

type Props = {
  title: string;
  description?: string;
};

const { title, description = siteConfig.tagline } = Astro.props;
const pageTitle = title === siteConfig.name ? title : `${title} · ${siteConfig.name}`;
const cmsPages = (await getCollection("pages"))
  .filter((page) => !isReservedPageSlug(page.id))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const siteUrl = getSiteUrl();
const supportUrl = getSupportUrl();
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = `${siteUrl}/images/ws42-logo-purple.svg`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type":
    siteConfig.legalName && siteConfig.legalName !== "{{legal name}}"
      ? "LocalBusiness"
      : "Organization",
  name: siteConfig.name,
  url: siteUrl,
  ...(siteConfig.legalName &&
    siteConfig.legalName !== "{{legal name}}" && {
      legalName: siteConfig.legalName,
    }),
  ...(siteConfig.contactEmail && {
    email: siteConfig.contactEmail,
  }),
  ...(siteConfig.mailingAddress &&
    siteConfig.mailingAddress !== "{{mailing address}}" && {
      address: siteConfig.mailingAddress,
    }),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content={description}>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="canonical" href={canonicalUrl}>
    <title>{pageTitle}</title>
    <meta property="og:title" content={pageTitle}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:type" content="website">
    <meta property="og:image" content={ogImage}>
    <meta property="og:site_name" content={siteConfig.name}>
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content={pageTitle}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImage}>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <Analytics />
  </head>
  <body class="min-h-screen">
    <a
      class="rounded-button bg-brand text-brand-ink absolute top-0 left-4 z-50 -translate-y-full px-4 py-2 focus:translate-y-4"
      href="#main"
      >Skip to content</a
    >
    <header class="border-line border-b bg-white shadow-sm">
      <div class="max-w-site mx-auto flex items-center justify-between gap-6 px-6 py-5">
        <a class="shrink-0 transition hover:opacity-80" href="/">
          <img
            class="h-9 w-auto"
            src="/images/ws42-logo-purple.svg"
            alt="Workshop 42"
            width="1432"
            height="360"
          >
        </a>
        <nav aria-label="Primary">
          <ul class="text-muted flex gap-6 text-sm font-medium">
            <li><a class="hover:text-brand transition" href="/">Home</a></li>
            {cmsPages.map((page) => (
              <li>
                <a class="hover:text-brand transition" href={`/${page.id}/`}>
                  {page.data.title}
                </a>
              </li>
            ))}
            <li><a class="hover:text-brand transition" href="/#contact">Contact</a></li>
            <li><a class="hover:text-brand transition" href="/privacy/">Privacy</a></li>
            <li><a class="hover:text-brand transition" href="/terms/">Terms</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="border-line bg-ink border-t">
      <div class="max-w-site mx-auto px-6 py-12">
        <div class="grid gap-12 md:grid-cols-[2fr_1fr_1fr]">
          <div>
            <img
              src="/images/ws42-logo-purple.svg"
              alt="Workshop 42"
              class="h-10 w-auto"
              width="1432"
              height="360"
            >
            <p class="mt-4 max-w-sm text-sm leading-relaxed opacity-70" style="color: #f5f5f0;">
              A local business site started from the WS42 factory.
            </p>
          </div>
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wider" style="color: #f5f5f0;">
              Company
            </h3>
            <ul class="mt-4 space-y-3">
              <li>
                <a
                  href="/"
                  class="text-sm opacity-70 transition hover:opacity-100"
                  style="color: #f5f5f0;"
                >
                  Home
                </a>
              </li>
              {cmsPages.map((page) => (
                <li>
                  <a
                    href={`/${page.id}/`}
                    class="text-sm opacity-70 transition hover:opacity-100"
                    style="color: #f5f5f0;"
                  >
                    {page.data.title}
                  </a>
                </li>
              ))}
              <li>
                <a
                  href="/#contact"
                  class="text-sm opacity-70 transition hover:opacity-100"
                  style="color: #f5f5f0;"
                >
                  Contact
                </a>
              </li>
            </ul>
          </div>
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wider" style="color: #f5f5f0;">
              Legal
            </h3>
            <ul class="mt-4 space-y-3">
              <li>
                <a
                  href="/privacy/"
                  class="text-sm opacity-70 transition hover:opacity-100"
                  style="color: #f5f5f0;"
                >
                  Privacy
                </a>
              </li>
              <li>
                <a
                  href="/terms/"
                  class="text-sm opacity-70 transition hover:opacity-100"
                  style="color: #f5f5f0;"
                >
                  Terms
                </a>
              </li>
            </ul>
          </div>
        </div>
        <div
          class="border-line mt-10 flex flex-col items-center justify-center gap-2 border-t border-white/10 pt-8 text-center sm:flex-row sm:gap-4"
        >
          <p class="text-sm opacity-60" style="color: #f5f5f0;">
            © {new Date().getFullYear()} {siteConfig.name}. All rights reserved.
          </p>
          {supportUrl.length > 0 && (
            <a
              href={supportUrl}
              rel="nofollow"
              class="text-xs opacity-60 transition hover:opacity-100"
              style="color: #f5f5f0;"
            >
              Website help
            </a>
          )}
        </div>
      </div>
    </footer>
  </body>
</html>
