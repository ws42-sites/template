---
import Base from "../layouts/Base.astro";
---

<Base title="Page Not Found">
  <section class="max-w-site mx-auto px-6 py-16 sm:py-24">
    <h1 class="font-display text-4xl leading-tight tracking-tight sm:text-5xl">Page Not Found</h1>
    <p class="text-muted mt-5 max-w-2xl text-lg">
      The page you're looking for doesn't exist. Try starting from the
      <a class="text-ink decoration-line underline underline-offset-4" href="/">home page</a>.
    </p>
  </section>
</Base>
