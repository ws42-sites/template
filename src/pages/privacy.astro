---
import Base from "../layouts/Base.astro";
import {
  getAnalyticsConfig,
  getFormspreeEndpoint,
  isSentryEnabled,
  siteConfig,
} from "../site.config";

const analytics = getAnalyticsConfig();
const formEnabled = getFormspreeEndpoint().length > 0;
const sentryEnabled = isSentryEnabled();
const processors = [
  formEnabled ? "Formspree" : "",
  analytics.provider === "plausible" ? "Plausible Analytics" : "",
  analytics.provider === "fathom" ? "Fathom Analytics" : "",
  sentryEnabled ? "Sentry" : "",
].filter((name) => name.length > 0);
---

<Base title="Privacy policy" description={`How ${siteConfig.name} handles personal information.`}>
  <article class="mx-auto max-w-3xl px-6 py-16">
    <p
      class="rounded-card border-accent/30 bg-accent/10 text-ink border px-4 py-3 text-sm"
      role="note"
    >
      This page is a starting point, not legal advice. Have a lawyer licensed in
      {siteConfig.jurisdiction}
      review it before you publish it.
    </p>
    <h1 class="font-display mt-8 text-4xl tracking-tight">Privacy policy</h1>
    <p class="text-muted mt-3">Last updated: {"{{effective date}}"}</p>

    <div class="mt-10 space-y-8 text-[17px] leading-7">
      <section>
        <h2 class="font-display text-2xl tracking-tight">Who we are</h2>
        <p class="mt-3">
          This policy is for {siteConfig.legalName} (“{siteConfig.name}”, “we”, “us”), operating in
          {siteConfig.jurisdiction}. You can reach us at
          <a
            class="decoration-line underline underline-offset-4"
            href={`mailto:${siteConfig.contactEmail}`}
            >{siteConfig.contactEmail}</a
          >
          or by mail at {siteConfig.mailingAddress}.
        </p>
      </section>

      <section>
        <h2 class="font-display text-2xl tracking-tight">The information we collect</h2>
        <p class="mt-3">
          We collect personal information that you choose to give us, such as your name, email
          address, and the contents of a message, when you contact us. We use it only to respond to
          you and to run this website, unless we have your consent or another lawful reason to use
          it for something else.
        </p>
        {formEnabled && (
          <p class="mt-3">
            Messages sent through the contact form are processed by Formspree so they can be
            delivered to us. Formspree’s privacy policy is at
            <a
              class="decoration-line underline underline-offset-4"
              href="https://formspree.io/legal/privacy-policy/"
            >
              https://formspree.io/legal/privacy-policy/
            </a>
            .
          </p>
        )}
      </section>

      {analytics.provider === "plausible" && (
        <section>
          <h2 class="font-display text-2xl tracking-tight">Analytics</h2>
          <p class="mt-3">
            We use Plausible Analytics to understand how people use this website. Plausible is
            designed not to use cookies or collect personal information for advertising. The site
            identifier in use is
            {analytics.domain}. See
            <a
              class="decoration-line underline underline-offset-4"
              href="https://plausible.io/data-policy"
            >
              Plausible’s data policy
            </a>
            .
          </p>
        </section>
      )}
      {analytics.provider === "fathom" && (
        <section>
          <h2 class="font-display text-2xl tracking-tight">Analytics</h2>
          <p class="mt-3">
            We use Fathom Analytics to understand how people use this website. Fathom is designed to
            avoid tracking people across sites or collecting personal information for advertising.
            See
            <a
              class="decoration-line underline underline-offset-4"
              href="https://usefathom.com/legal"
            >
              Fathom’s legal pages
            </a>
            .
          </p>
        </section>
      )}

      {sentryEnabled && (
        <section>
          <h2 class="font-display text-2xl tracking-tight">Error monitoring</h2>
          <p class="mt-3">
            We use Sentry to find and fix technical errors on this website. Sentry may receive
            information such as the page you were on, your browser type, and a truncated IP address
            when an error occurs. See
            <a
              class="decoration-line underline underline-offset-4"
              href="https://sentry.io/privacy/"
            >
              Sentry’s privacy policy
            </a>
            .
          </p>
        </section>
      )}

      <section>
        <h2 class="font-display text-2xl tracking-tight">How we share information</h2>
        <p class="mt-3">
          We do not sell your personal information. We share it only with the service providers we
          need to operate this website
          {processors.length > 0 ? (
            <>, currently {processors.join(", ")}</>
          ) : (
            ", once those services are connected"
          )}, or when the law requires us to.
        </p>
      </section>

      <section>
        <h2 class="font-display text-2xl tracking-tight">Your rights</h2>
        <p class="mt-3">
          If you are in Canada, {siteConfig.privacyLaw} gives you the right to know what personal
          information we hold about you, to ask for a correction, and to withdraw consent when we
          rely on it. To make a request, email {siteConfig.contactEmail}. If you are not satisfied
          with our response, you may contact the Office of the Privacy Commissioner of Canada or the
          privacy authority in {siteConfig.jurisdiction}.
        </p>
      </section>

      <section>
        <h2 class="font-display text-2xl tracking-tight">How long we keep information</h2>
        <p class="mt-3">
          We keep contact messages and related records only as long as we need them to answer you,
          keep a business record, or meet a legal requirement, and then we delete or securely
          archive them. {"{{retention period}}"}.
        </p>
      </section>
    </div>
  </article>
</Base>
