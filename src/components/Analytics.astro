---
import { getAnalyticsConfig, getSiteUrl } from "../site.config";

const analytics = getAnalyticsConfig({
  siteUrl: getSiteUrl(),
  hostname: Astro.url.hostname,
});
---

{analytics.provider === "cloudflare" && (
  <script
    is:inline
    defer
    src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon={JSON.stringify({ token: analytics.cloudflareToken })}
  />
)}
{analytics.provider === "plausible" && (
  <script is:inline defer data-domain={analytics.domain} src="https://plausible.io/js/script.js" />
)}
{analytics.provider === "fathom" && (
  <script is:inline defer data-site={analytics.siteId} src="https://cdn.usefathom.com/script.js" />
)}
