---
import { getFormspreeEndpoint, siteConfig } from "../site.config";

const endpoint = getFormspreeEndpoint();
---

{endpoint.length === 0 ? (
  <p class="rounded-card border-line bg-surface-alt text-muted border px-5 py-4" role="status">
    The contact form is not connected yet. Set <code class="text-ink">PUBLIC_FORMSPREE_ID</code> or
    <code class="text-ink">formspreeFormId</code> in{" "}
    <code class="text-ink">src/site.config.ts</code>.
  </p>
) : (
  <form class="relative space-y-5" method="post" action={endpoint} data-contact-form>
    <div
      class="pointer-events-none absolute h-px w-px overflow-hidden opacity-0"
      aria-hidden="true"
    >
      <label for="company-website">Company website</label>
      <input id="company-website" type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
    </div>
    <input type="hidden" name="form_opened_at" id="form-opened-at" value="" />
    <input type="hidden" name="_subject" value={`Website message for ${siteConfig.name}`} />

    <div class="grid gap-5 sm:grid-cols-2">
      <p class="flex flex-col gap-2">
        <label class="text-sm font-medium" for="contact-name">
          Name
        </label>
        <input
          class="rounded-card border-line text-ink border bg-white px-3 py-2.5"
          id="contact-name"
          type="text"
          name="name"
          autocomplete="name"
          required
        />
      </p>
      <p class="flex flex-col gap-2">
        <label class="text-sm font-medium" for="contact-email">
          Email
        </label>
        <input
          class="rounded-card border-line text-ink border bg-white px-3 py-2.5"
          id="contact-email"
          type="email"
          name="email"
          autocomplete="email"
          required
        />
      </p>
    </div>
    <p class="flex flex-col gap-2">
      <label class="text-sm font-medium" for="contact-message">
        Message
      </label>
      <textarea
        class="rounded-card border-line text-ink min-h-36 border bg-white px-3 py-2.5"
        id="contact-message"
        name="message"
        required
      />
    </p>
    <div class="flex flex-wrap items-center gap-4">
      <button
        class="rounded-button bg-brand text-brand-ink hover:bg-brand/90 px-5 py-2.5 font-medium disabled:opacity-60"
        type="submit"
      >
        Send message
      </button>
      <p class="text-muted text-sm" id="form-status" role="status" aria-live="polite"></p>
    </div>
  </form>
)}

<script>
const MIN_DELAY_MS = 3000;
const MAX_AGE_MS = 24 * 60 * 60 * 1000;
const COOLDOWN_MS = 30_000;

function errorMessage(payload: unknown): string {
  if (payload && typeof payload === "object") {
    if ("errors" in payload && Array.isArray(payload.errors)) {
      const first = payload.errors[0];
      if (
        first &&
        typeof first === "object" &&
        "message" in first &&
        typeof first.message === "string"
      ) {
        return first.message;
      }
    }
    if ("error" in payload && typeof payload.error === "string") {
      return payload.error;
    }
  }
  return "Something went wrong. Please try again later.";
}

const form = document.querySelector("[data-contact-form]");
if (form instanceof HTMLFormElement) {
  const openedAt = form.querySelector("#form-opened-at");
  const status = form.querySelector("#form-status");
  const submit = form.querySelector("button[type=submit]");
  const started = Date.now();

  if (openedAt instanceof HTMLInputElement) {
    openedAt.value = String(started);
  }

  let lastSubmitAt = 0;
  let inFlight = false;

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!(status instanceof HTMLElement) || !(submit instanceof HTMLButtonElement)) {
      return;
    }

    const now = Date.now();
    const opened = Number(openedAt instanceof HTMLInputElement ? openedAt.value : started);

    if (!Number.isFinite(opened) || now - opened < MIN_DELAY_MS) {
      status.textContent = "Please wait a moment and try again.";
      return;
    }
    if (now - opened > MAX_AGE_MS) {
      status.textContent = "This form has expired. Refresh the page and try again.";
      return;
    }
    if (inFlight || now - lastSubmitAt < COOLDOWN_MS) {
      status.textContent = "Please wait before sending another message.";
      return;
    }

    inFlight = true;
    submit.disabled = true;
    status.textContent = "Sending…";

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });

      if (response.status === 429) {
        status.textContent =
          "Too many messages were just sent. Please wait a minute and try again.";
        window.setTimeout(() => {
          submit.disabled = false;
        }, COOLDOWN_MS);
        return;
      }

      if (response.ok) {
        lastSubmitAt = Date.now();
        form.reset();
        if (openedAt instanceof HTMLInputElement) {
          openedAt.value = String(Date.now());
        }
        status.textContent = "Thanks. Your message was sent.";
        window.setTimeout(() => {
          submit.disabled = false;
        }, COOLDOWN_MS);
        return;
      }

      const payload: unknown = await response.json().catch(() => null);
      status.textContent = errorMessage(payload);
      submit.disabled = false;
    } catch {
      status.textContent = "Something went wrong. Please try again later.";
      submit.disabled = false;
    } finally {
      inFlight = false;
    }
  });
}
</script>
